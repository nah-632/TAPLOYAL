# taployal — environment template. Copy to .env.local and fill in. NEVER commit real values.
#
# Supabase (Phase 0)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only; never exposed to the client

# Apple Wallet (Phase 3 — real provider only; mock provider needs none)
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERT_P12_BASE64=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_PEM=

# Google Wallet (Phase 2 — real provider only)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# Payments (Phase 6 — mock provider is the default)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
