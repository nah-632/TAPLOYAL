# taployal — environment template. Copy to .env.local and fill in.
# NEVER commit real values. See docs/adr/ADR-001-cranl-native-infrastructure.md

# ─── Runtime database ────────────────────────────────────────────────────────
# MUST be the RESTRICTED role (NOBYPASSRLS). Connecting as the provider's admin
# role silently disables every RLS policy; instrumentation.ts refuses to boot.
# Inside CranL, use the INTERNAL host: <db>-cadoql:5432
DATABASE_URL=

# ─── Authentication (Better Auth) ────────────────────────────────────────────
# Required in production (boot fails closed without it). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of this deployment, e.g. https://taployal.cranl.net
BETTER_AUTH_URL=
APP_URL=

# ─── Apple Wallet (later phase; mock provider needs none) ────────────────────
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERT_P12_BASE64=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_PEM=

# ─── Google Wallet (later phase) ─────────────────────────────────────────────
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# ─── Payments ────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
